{
  "type": "origins:multiple",
  "name": "Mimicry",
  "description": "Sneak for 3 seconds to blend in: mobs and illagers ignore you until you stand up or attack.",
  "charge": {
    "type": "origins:resource",
    "min": 0,
    "max": 60,
    "start_value": 0,
    "hud_render": {
      "should_render": false
    }
  },
  "build": {
    "type": "origins:action_over_time",
    "interval": 1,
    "condition": {
      "type": "origins:sneaking"
    },
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mdvlcraft:changeling/mimicry_charge",
      "change": 1
    }
  },
  "drop": {
    "type": "origins:action_over_time",
    "interval": 1,
    "condition": {
      "type": "origins:sneaking",
      "inverted": true
    },
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mdvlcraft:changeling/mimicry_charge",
      "change": 0,
      "operation": "set"
    }
  },
  "break": {
    "type": "origins:self_action_on_hit",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mdvlcraft:changeling/mimicry_charge",
      "change": 0,
      "operation": "set"
    }
  },
  "unnoticed": {
    "type": "apugli:mobs_ignore",
    "condition": {
      "type": "origins:resource",
      "resource": "mdvlcraft:changeling/mimicry_charge",
      "comparison": ">=",
      "compare_to": 60
    }
  }
}
